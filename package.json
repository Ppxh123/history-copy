{
  "name": "clipboard-history",
  "version": "1.0.0",
  "description": "Windows 历史粘贴板管理软件",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.node.json && unset ELECTRON_RUN_AS_NODE && electron .",
    "dev": "concurrently -n renderer,electron \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.node.json && cp node_modules/sql.js/dist/sql-wasm.wasm dist-electron/sql-wasm.wasm && cp electron/floating-ball.html dist-electron/floating-ball.html",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "unset ELECTRON_RUN_AS_NODE && electron .",
    "pack": "npm run build && unset ELECTRON_RUN_AS_NODE && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.clipboard-history.app",
    "productName": "历史粘贴板",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "language": "2052"
    }
  }
}
